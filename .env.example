# Example Environment Variables for Codegen Classroom
# Copy this file to .env and fill in your values.

# Default LLM backend: "gemini" or "openai_compat" (alias "vllm").
# Run configs (configs/*.yaml) can set llm.backend per run or per student.
# CODEGEN_BACKEND=vllm

# OpenAI-compatible server (vLLM) URL, see scripts/serve_vllm.sh.
# VLLM_BASE_URL=http://localhost:8000/v1
# Only needed if the server was started with --api-key.
# VLLM_API_KEY=

# Gemini API Key (only for students using the gemini backend)
GEMINI_API_KEY=your_api_key_here

# Optional: Default output directory for experiment artifacts
# CODEGEN_EXPERIMENTS_DIR=/path/to/experiments

# Optional: Default logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
